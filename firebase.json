{
  "hosting": {
    "site": "guilleysilvi",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": true,
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/_astro/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "redirects": [
      {
        "regex": "^/alojamiento/?$",
        "destination": "/transporte/#alojamiento",
        "type": 301
      },
      {
        "regex": "^/ca/allotjament/?$",
        "destination": "/ca/transport/#alojamiento",
        "type": 301
      },
      {
        "regex": "^/en/where-to-stay/?$",
        "destination": "/en/getting-there/#alojamiento",
        "type": 301
      },
      {
        "regex": "^/tr/konaklama/?$",
        "destination": "/tr/ulasim/#alojamiento",
        "type": 301
      }
    ]
  }
}
