---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Countdown from '@/components/Countdown.astro';
import Icon from '@/components/Icon.astro';
import SectionHead from '@/components/SectionHead.astro';
import Timeline from '@/components/Timeline.astro';
import { getDictionary, getLocale, l } from '@/i18n';
import { href } from '@/i18n/routes';
import { siteConfig } from '@/site.config';
import { heroAlt, heroImage, heroIsPlaceholder } from '@/data/gallery';

const locale = getLocale(Astro.currentLocale);
const t = getDictionary(locale);
---

<Base page="home">
  <!-- Portada: nombres y fecha, la foto enseguida y, debajo, la cuenta atrás y las dos acciones -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__head reveal">
        <h1 class="display hero__names">
          <span class="hero__line">{siteConfig.couple.first}</span>
          <span class="hero__line"><span class="hero__amp">&amp;</span> {siteConfig.couple.second}</span>
        </h1>
        <p class="hero__date">
          <span class="hero__date-num tabular">{t.common.dateShort}</span>
          <span class="eyebrow">{t.common.city}</span>
        </p>
      </div>

      <figure class:list={['hero__media reveal reveal--2', { 'hero__media--placeholder': heroIsPlaceholder }]}>
        {
          heroImage && (
            <Image
              class="hero__img"
              src={heroImage}
              alt={heroIsPlaceholder ? '' : l(heroAlt, locale) || t.hero.photoAlt}
              widths={[640, 960, 1400]}
              sizes="(min-width: 64em) 44vw, 100vw"
              loading="eager"
              fetchpriority="high"
            />
          )
        }
      </figure>

      <div class="hero__body reveal reveal--3">
        <p class="hero__tagline">
          <span class="emoji" aria-hidden="true">📍</span>
          {t.hero.tagline}
        </p>
        <Countdown compact class="hero__countdown" />
        <div class="hero__cta">
          <a class="btn btn--accent btn--lg hero__rsvp" href={href(locale, 'rsvp')}>
            <span class="emoji" aria-hidden="true">✉️</span>
            {t.common.rsvp}
          </a>
          <a class="btn btn--ghost hero__quiz" href={href(locale, 'quiz')}>
            <span class="emoji" aria-hidden="true">🎯</span>
            {t.hero.quizCta}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- El recorrido del día -->
  <section class="section day">
    <div class="container">
      <SectionHead eyebrow={`${t.home.dayEyebrow} 🗓️`} title={t.home.dayTitle} />
      <div class="day__timeline">
        <Timeline compact />
      </div>
      <p class="small muted day__note">{t.day.note}</p>
      <p class="day__cta">
        <a class="arrow-link" href={href(locale, 'day')}>{t.home.dayCta}<Icon name="arrowRight" /></a>
      </p>
    </div>
  </section>

  <!-- El juego -->
  <section class="section section--flush-top">
    <div class="container">
      <div class="game">
        <span class="game__emoji" aria-hidden="true">🎯</span>
        <div class="game__text">
          <h2 class="title-lg">{t.home.quizTitle}</h2>
          <p class="game__lead">{t.home.quizText}</p>
        </div>
        <div class="game__actions">
          <a class="btn btn--primary" href={href(locale, 'quiz')}>{t.home.quizBtn}<Icon name="arrowRight" /></a>
          <a class="arrow-link" href={href(locale, 'ranking')}>{t.nav.ranking}<Icon name="arrowRight" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Confirmar, otra vez, al final -->
  <section class="section section--flush-top">
    <div class="container">
      <div class="banner">
        <div class="banner__text">
          <p class="eyebrow banner__eyebrow">{t.home.rsvpEyebrow}</p>
          <h2 class="title-lg">{t.home.rsvpTitle}</h2>
          <p class="banner__lead">{t.home.rsvpText}</p>
        </div>
        <a class="btn btn--accent btn--lg banner__btn" href={href(locale, 'rsvp')}><span class="emoji" aria-hidden="true">✉️</span>{t.common.rsvp}</a>
        <Icon name="waves" class="banner__mark" />
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Portada ---------- */
  .hero {
    padding-block: clamp(1rem, 3vw, 3rem) clamp(1.5rem, 4vw, 3rem);
  }

  .hero__grid {
    display: grid;
    gap: 1.25rem;
  }

  /* Móvil: nombres a la izquierda, fecha a la derecha; la foto justo debajo. */
  .hero__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }

  .hero__names {
    display: flex;
    flex-direction: column;
    font-size: clamp(3rem, 13vw, 9.5rem);
  }

  .hero__line:last-child {
    padding-left: 0.05em;
  }

  .hero__amp {
    font-style: italic;
    color: var(--sea);
  }

  .hero__date {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.2rem;
    padding-bottom: 0.35em;
    text-align: right;
  }

  .hero__date-num {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 5vw, 1.75rem);
    line-height: 1;
    color: var(--sea-dark);
  }

  .hero__media {
    margin-inline: calc(-1 * var(--gutter));
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--sea-3);
  }

  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__tagline {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    max-width: 26ch;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 5vw, 1.875rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .hero__tagline .emoji {
    font-size: 0.8em;
    margin-top: 0.2em;
  }

  .hero__countdown {
    margin-top: 1rem;
  }

  .hero__cta {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .hero__rsvp .emoji {
    font-size: 1.1em;
  }

  @media (min-width: 40em) {
    .hero__media {
      margin-inline: 0;
      border-radius: var(--radius-lg);
    }
    .hero__cta {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
    }
  }

  /* Escritorio: texto a la izquierda, foto a la derecha. */
  @media (min-width: 64em) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      grid-template-areas:
        'head media'
        'body media';
      column-gap: clamp(2rem, 6vw, 5rem);
      row-gap: 1.5rem;
      align-items: center;
    }
    .hero__head {
      grid-area: head;
      flex-direction: column;
      align-items: flex-start;
      align-self: end;
    }
    .hero__date {
      align-items: flex-start;
      text-align: left;
      flex-direction: row;
      align-items: baseline;
      gap: 0.75rem;
      padding-bottom: 0;
      margin-top: 1rem;
    }
    .hero__body {
      grid-area: body;
      align-self: start;
    }
    .hero__media {
      grid-area: media;
      position: relative;
      max-height: 42rem;
    }
    .hero__img {
      position: absolute;
      inset: 0;
    }
  }

  /* ---------- El día ---------- */
  .day__timeline {
    max-width: 44rem;
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
  }

  .day__note {
    max-width: 60ch;
  }

  .day__cta {
    margin-top: 1.25rem;
  }

  /* ---------- El juego ---------- */
  .game {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: clamp(1.5rem, 5vw, 2.5rem);
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--sun-2), var(--coral-2));
  }

  .game__emoji {
    font-size: 2.5rem;
    line-height: 1;
  }

  .game__lead {
    margin-top: 0.75rem;
    max-width: 48ch;
    color: var(--ink-2);
  }

  .game__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  @media (min-width: 48em) {
    .game {
      flex-direction: row;
      align-items: center;
    }
    .game__text {
      flex: 1;
    }
  }

  /* ---------- Banner RSVP ---------- */
  .banner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding: clamp(2rem, 6vw, 4rem);
    border-radius: var(--radius-lg);
    background: var(--ink);
    color: var(--paper);
    overflow: hidden;
  }

  .banner__eyebrow {
    color: var(--sea-2);
  }

  .banner__lead {
    margin-top: 1rem;
    max-width: 44ch;
    color: rgba(246, 243, 238, 0.78);
    font-size: 1.0625rem;
  }

  .banner .title-lg {
    margin-top: 0.75rem;
  }

  .banner__btn {
    align-self: flex-start;
  }

  .banner__mark {
    position: absolute;
    right: -1rem;
    bottom: -1.5rem;
    width: 11rem;
    height: 11rem;
    color: rgba(246, 243, 238, 0.08);
    stroke-width: 0.6;
  }

  @media (min-width: 48em) {
    .banner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
    .banner__btn {
      align-self: center;
      flex: none;
    }
  }
</style>
