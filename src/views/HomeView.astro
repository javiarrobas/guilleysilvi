---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Countdown from '@/components/Countdown.astro';
import Icon from '@/components/Icon.astro';
import SectionHead from '@/components/SectionHead.astro';
import { getDictionary, getLocale, l } from '@/i18n';
import { href, pageKeys } from '@/i18n/routes';
import { siteConfig } from '@/site.config';
import { heroAlt, heroImage, heroIsPlaceholder } from '@/data/gallery';

const locale = getLocale(Astro.currentLocale);
const t = getDictionary(locale);
const indexPages = pageKeys.filter((key) => key !== 'home');
---

<Base page="home">
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__head">
        <p class="eyebrow reveal">{t.hero.eyebrow}</p>
        <h1 class="display hero__names reveal">
          <span class="hero__line">{siteConfig.couple.first}</span>
          <span class="hero__line"><span class="hero__amp">&amp;</span> {siteConfig.couple.second}</span>
        </h1>
      </div>

      <figure class:list={['hero__media reveal reveal--2', { 'hero__media--placeholder': heroIsPlaceholder }]}>
        {
          heroImage && (
            <Image
              class="hero__img"
              src={heroImage}
              alt={heroIsPlaceholder ? '' : l(heroAlt, locale) || t.hero.photoAlt}
              widths={[640, 960, 1400]}
              sizes="(min-width: 64em) 44vw, 100vw"
              loading="eager"
              fetchpriority="high"
            />
          )
        }
      </figure>

      <div class="hero__body">
        <p class="hero__tagline reveal reveal--2">
          <Icon name="north" class="hero__north" />
          {t.hero.tagline}
        </p>
        <Countdown class="hero__countdown reveal reveal--3" />
        <div class="hero__cta reveal reveal--3">
          <a class="btn btn--primary" href={href(locale, 'rsvp')}>{t.common.rsvp}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section essentials">
    <div class="container">
      <p class="eyebrow">{t.home.essentialsEyebrow}</p>
      <ul class="essentials__list">
        {
          t.home.essentials.map((item) => (
            <li class="essentials__item">
              <p class="eyebrow eyebrow--ink">{item.label}</p>
              <h2 class="essentials__title">{item.title}</h2>
              <p class="small muted">{item.detail}</p>
              <a class="arrow-link essentials__link" href={href(locale, item.page)}>
                {t.nav[item.page]}
                <Icon name="arrowRight" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--flush-top">
    <div class="container">
      <SectionHead eyebrow={t.home.indexEyebrow} title={t.home.indexTitle} />
      <ol class="index">
        {
          indexPages.map((key) => (
            <li>
              <a class="index__link" href={href(locale, key)}>
                <span class="index__text">
                  <span class="index__title">{t.nav[key]}</span>
                  <span class="index__desc">{t.home.index[key]}</span>
                </span>
                <Icon name="arrowRight" class="index__arrow" />
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--flush-top">
    <div class="container">
      <div class="banner">
        <div class="banner__text">
          <p class="eyebrow banner__eyebrow">{t.home.rsvpEyebrow}</p>
          <h2 class="title-lg">{t.home.rsvpTitle}</h2>
          <p class="banner__lead">{t.home.rsvpText}</p>
        </div>
        <a class="btn banner__btn" href={href(locale, 'rsvp')}>{t.common.rsvp}</a>
        <Icon name="waves" class="banner__mark" />
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Portada ---------- */
  .hero {
    padding-block: clamp(1.5rem, 5vw, 4.5rem) clamp(2rem, 5vw, 4rem);
  }

  .hero__grid {
    display: grid;
    gap: clamp(1.5rem, 5vw, 2.5rem);
  }

  .hero__names {
    display: flex;
    flex-direction: column;
    margin-top: 0.9rem;
  }

  .hero__line:last-child {
    padding-left: 0.05em;
  }

  .hero__amp {
    font-style: italic;
    color: var(--sea);
  }

  .hero__media {
    margin-inline: calc(-1 * var(--gutter));
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--sea-3);
  }

  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__tagline {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    max-width: 24ch;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 5.5vw, 2.25rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .hero__north {
    flex: none;
    width: 1em;
    height: 1em;
    margin-top: 0.15em;
    color: var(--sea);
  }

  .hero__countdown {
    margin-top: clamp(1.75rem, 5vw, 2.75rem);
  }

  .hero__cta {
    margin-top: clamp(1.75rem, 5vw, 2.5rem);
  }

  .hero__cta .btn {
    width: 100%;
  }

  @media (min-width: 40em) {
    .hero__media {
      margin-inline: 0;
      border-radius: var(--radius-lg);
    }
    .hero__cta .btn {
      width: auto;
    }
  }

  @media (min-width: 64em) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      grid-template-areas:
        'head media'
        'body media';
      column-gap: clamp(2rem, 6vw, 5rem);
      align-items: stretch;
    }
    .hero__head {
      grid-area: head;
    }
    .hero__body {
      grid-area: body;
      align-self: end;
    }
    .hero__media {
      grid-area: media;
      aspect-ratio: auto;
      min-height: 100%;
    }
    .hero__img {
      position: absolute;
      inset: 0;
    }
    .hero__media {
      position: relative;
    }
  }

  /* ---------- Lo esencial ---------- */
  .essentials__list {
    display: grid;
    margin-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .essentials__item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--line);
  }

  .essentials__title {
    font-size: clamp(1.5rem, 4.5vw, 1.875rem);
    margin-top: 0.25rem;
  }

  .essentials__link {
    margin-top: 0.75rem;
  }

  @media (min-width: 48em) {
    .essentials__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0 2rem;
    }
    .essentials__item {
      padding: 2rem 0;
    }
  }

  /* ---------- Índice ---------- */
  .index {
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    border-top: 1px solid var(--line);
  }

  .index__link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1.5rem;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  .index__text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .index__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 5vw, 2.25rem);
    line-height: 1.1;
    transition: color 0.2s var(--ease);
  }

  .index__desc {
    font-size: 0.9375rem;
    color: var(--stone);
  }

  .index__arrow {
    color: var(--stone);
    transition: transform 0.25s var(--ease), color 0.25s var(--ease);
  }

  .index__link:hover .index__title {
    color: var(--sea);
    font-style: italic;
  }

  .index__link:hover .index__arrow {
    transform: translateX(4px);
    color: var(--ink);
  }

  @media (min-width: 48em) {
    .index__text {
      flex-direction: row;
      align-items: baseline;
      gap: 1.25rem;
    }
    .index__title {
      min-width: 14rem;
    }
  }

  /* ---------- Banner RSVP ---------- */
  .banner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding: clamp(2rem, 6vw, 4rem);
    border-radius: var(--radius-lg);
    background: var(--ink);
    color: var(--paper);
    overflow: hidden;
  }

  .banner__eyebrow {
    color: var(--sea-2);
  }

  .banner__lead {
    margin-top: 1rem;
    max-width: 44ch;
    color: rgba(246, 243, 238, 0.78);
    font-size: 1.0625rem;
  }

  .banner .title-lg {
    margin-top: 0.75rem;
  }

  .banner__btn {
    align-self: flex-start;
    background: var(--paper);
    border-color: var(--paper);
    color: var(--ink);
  }

  .banner__btn:hover {
    background: var(--sea-2);
    border-color: var(--sea-2);
    color: var(--ink);
  }

  .banner__mark {
    position: absolute;
    right: -1rem;
    bottom: -1.5rem;
    width: 11rem;
    height: 11rem;
    color: rgba(246, 243, 238, 0.08);
    stroke-width: 0.6;
  }

  @media (min-width: 48em) {
    .banner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
    .banner__btn {
      align-self: center;
      flex: none;
    }
  }
</style>
