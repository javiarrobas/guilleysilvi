---
import Base from '@/layouts/Base.astro';
import SectionHead from '@/components/SectionHead.astro';
import PlaceCard from '@/components/PlaceCard.astro';
import PhotoBanner from '@/components/PhotoBanner.astro';
import { getDictionary, getLocale } from '@/i18n';
import { places } from '@/data/santander';

const locale = getLocale(Astro.currentLocale);
const t = getDictionary(locale);
---

<Base page="santander" title={t.nav.santander}>
  <header class="container page-head">
    <SectionHead as="h1" size="xl" eyebrow={`${t.santander.eyebrow} 🍽️`} title={t.santander.title} lead={t.santander.lead} />
  </header>

  <section class="container section section--flush-top">
    <div class="collage">
      {places.map((place) => <PlaceCard place={place} />)}
    </div>
  </section>

  <PhotoBanner id="11-img-7183" />
</Base>

<style>
  .collage {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 40em) {
    .collage {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64em) {
    .collage {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }
</style>
