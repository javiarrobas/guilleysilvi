---
import Base from '@/layouts/Base.astro';
import SectionHead from '@/components/SectionHead.astro';
import GiftCard from '@/components/GiftCard.astro';
import PhotoBanner from '@/components/PhotoBanner.astro';
import { getDictionary, getLocale } from '@/i18n';

const locale = getLocale(Astro.currentLocale);
const t = getDictionary(locale);
---

<Base page="gift" title={t.nav.gift}>
  <header class="container page-head">
    <SectionHead as="h1" size="xl" eyebrow={t.gift.eyebrow} title={t.gift.title} />
  </header>

  <section class="container section section--flush-top">
    <GiftCard id="regalo" />
  </section>

  <PhotoBanner id="04-img-2839" />
</Base>
