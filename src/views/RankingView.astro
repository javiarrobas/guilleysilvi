---
import Base from '@/layouts/Base.astro';
import SectionHead from '@/components/SectionHead.astro';
import RankingBoard from '@/components/RankingBoard.astro';
import { getDictionary, getLocale } from '@/i18n';

const locale = getLocale(Astro.currentLocale);
const t = getDictionary(locale);
---

<Base page="ranking" title={t.nav.ranking}>
  <header class="container page-head">
    <SectionHead as="h1" size="xl" eyebrow={t.ranking.eyebrow} title={t.ranking.title} lead={t.ranking.lead} />
  </header>
  <section class="container section section--flush-top">
    <RankingBoard />
  </section>
</Base>
