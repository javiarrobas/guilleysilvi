---
import Base from '@/layouts/Base.astro';
import SectionHead from '@/components/SectionHead.astro';
import VenueMap from '@/components/VenueMap.astro';
import AccommodationCard from '@/components/AccommodationCard.astro';
import PhotoBanner from '@/components/PhotoBanner.astro';
import Icon from '@/components/Icon.astro';
import { getDictionary, getLocale } from '@/i18n';
import { busLocation, stayZone } from '@/data/locations';
import { accommodations, accommodationGroups } from '@/data/accommodations';

const locale = getLocale(Astro.currentLocale);
const t = getDictionary(locale);
const grouped = accommodationGroups
  .map((group) => ({ group, items: accommodations.filter((item) => item.group === group) }))
  .filter(({ items }) => items.length > 0);
---

<Base page="stay" title={t.nav.stay}>
  <header class="container page-head">
    <SectionHead as="h1" size="xl" eyebrow={`${t.stay.eyebrow} 🏨`} title={t.stay.title} lead={t.stay.lead} />
  </header>

  <section class="container section section--flush-top">
    <div class="zone">
      <VenueMap locations={[busLocation]} zone={stayZone} zoneLabel={t.stay.zoneTitle} fit="zone" class="zone__map" />
      <div class="zone__text">
        <p class="eyebrow">{t.stay.zoneEyebrow}</p>
        <h2 class="title-md">{t.stay.zoneTitle}</h2>
        <p class="zone__desc">{t.stay.zoneText}</p>
        <a class="btn btn--ghost btn--sm" href={busLocation.mapsUrl} target="_blank" rel="noopener noreferrer">
          {busLocation.name}
          <Icon name="external" />
        </a>
      </div>
    </div>
  </section>

  <section class="container section section--flush-top">
    <div class="help">
      <span class="help__emoji" aria-hidden="true">💬</span>
      <div>
        <h2 class="title-md">{t.stay.helpTitle}</h2>
        <p class="help__text">{t.stay.helpText}</p>
      </div>
    </div>
  </section>

  {
    grouped.map(({ group, items }) => (
      <section class="container section section--flush-top">
        <SectionHead title={t.stay.groups[group]} size="md" />
        <div class="grid grid--3 cards">
          {items.map((item) => (
            <AccommodationCard item={item} />
          ))}
        </div>
      </section>
    ))
  }

  <PhotoBanner id="01-img-8506" />
</Base>

<style>
  .zone {
    display: grid;
    gap: 1.5rem;
  }

  .zone__desc {
    margin: 1rem 0 1.25rem;
    color: var(--ink-2);
  }

  .zone__text .title-md {
    margin-top: 0.75rem;
  }

  @media (min-width: 64em) {
    .zone {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      align-items: center;
      gap: 3rem;
    }
  }

  .help {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: clamp(1.5rem, 5vw, 2.5rem);
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--coral-2), var(--sun-2));
  }

  .help__emoji {
    font-size: 2rem;
    line-height: 1;
  }

  .help__text {
    margin: 0.75rem 0 1.25rem;
    max-width: 52ch;
    color: var(--ink-2);
  }

  .cards {
    margin-top: 1.5rem;
  }

</style>
