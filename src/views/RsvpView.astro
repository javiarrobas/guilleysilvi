---
import Base from '@/layouts/Base.astro';
import SectionHead from '@/components/SectionHead.astro';
import SoonBadge from '@/components/SoonBadge.astro';
import Icon from '@/components/Icon.astro';
import { getDictionary, getLocale } from '@/i18n';
import { href } from '@/i18n/routes';
import { siteConfig } from '@/site.config';
import { firebaseConfigured } from '@/lib/firebase';
import RsvpForm from '@/components/RsvpForm.astro';

const locale = getLocale(Astro.currentLocale);
const t = getDictionary(locale);
const formUrl = siteConfig.rsvpFormUrl.trim();
const deadline = siteConfig.rsvpDeadline[locale]?.trim() || siteConfig.rsvpDeadline.es.trim();
/** 'embedded' (formulario propio) · 'external' (enlace) · 'soon' */
const mode = formUrl ? 'external' : firebaseConfigured ? 'embedded' : 'soon';
---

<Base page="rsvp" title={t.nav.rsvp}>
  <header class="container page-head">
    <SectionHead as="h1" size="xl" eyebrow={t.rsvp.eyebrow} title={t.rsvp.title} lead={t.rsvp.lead} />
  </header>

  <section class="container section section--flush-top">
    <div class="rsvp">
      <p class="rsvp__deadline rsvp__deadline--top">
        <span class="eyebrow eyebrow--ink">{t.rsvp.deadlineLabel}</span>
        <span>{deadline || t.rsvp.deadlineSoon}</span>
      </p>

      {mode === 'embedded' && <RsvpForm />}

      {
        mode !== 'embedded' && (
          <div class="rsvp__action">
            {mode === 'external' ? (
            <a class="btn btn--primary btn--block" href={formUrl} target="_blank" rel="noopener noreferrer">
              {t.rsvp.button}
              <Icon name="external" />
            </a>
          ) : (
            <>
              <span class="btn btn--block" aria-disabled="true">
                {t.rsvp.buttonSoon}
              </span>
              <p class="small muted rsvp__soon">
                <SoonBadge />
                {t.rsvp.soonText}
              </p>
            </>
          )}
          </div>
        )
      }

      <p class="rsvp__faq">
        <a class="arrow-link" href={href(locale, 'faq')}>{t.nav.faq}<Icon name="arrowRight" /></a>
      </p>

    </div>
  </section>
</Base>

<style>
  .rsvp {
    max-width: 44rem;
  }

  .rsvp__deadline--top {
    max-width: 34rem;
    margin-bottom: clamp(1.75rem, 4vw, 2.5rem);
    padding-top: 0;
    border-top: 0;
  }

  .rsvp__faq {
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  .rsvp__action {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .rsvp__soon {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .rsvp__deadline {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    color: var(--ink-2);
  }

</style>
