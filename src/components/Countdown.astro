---
/**
 * Cuenta atrás hasta la ceremonia: DÍAS : HORAS : MINUTOS : SEGUNDOS.
 * Se renderiza con los valores del momento de la compilación y el script la
 * actualiza cada segundo en el navegador. El día de la boda (y después) muestra
 * un mensaje en lugar de las cifras.
 */
import { getDictionary, getLocale } from '@/i18n';
import { siteConfig } from '@/site.config';

interface Props {
  class?: string;
}

const { class: className, ...rest } = Astro.props;
const t = getDictionary(getLocale(Astro.currentLocale));

const target = new Date(siteConfig.weddingDate);
const diff = Math.max(0, target.getTime() - Date.now());
const pad = (n: number) => String(n).padStart(2, '0');
const units = [
  { key: 'days', value: String(Math.floor(diff / 86_400_000)), label: t.countdown.days },
  { key: 'hours', value: pad(Math.floor((diff / 3_600_000) % 24)), label: t.countdown.hours },
  { key: 'minutes', value: pad(Math.floor((diff / 60_000) % 60)), label: t.countdown.minutes },
  { key: 'seconds', value: pad(Math.floor((diff / 1000) % 60)), label: t.countdown.seconds },
];
---

<div
  {...rest}
  class:list={['countdown', className]}
  data-countdown
  data-target={siteConfig.weddingDate}
  data-today={t.countdown.today}
  data-past={t.countdown.past}
>
  <p class="eyebrow countdown__label" data-countdown-label>{t.countdown.label}</p>
  <div class="countdown__units" role="timer" data-countdown-units>
    {
      units.map((unit, i) => (
        <>
          {i > 0 && (
            <span class="countdown__sep" aria-hidden="true">
              :
            </span>
          )}
          <div class="countdown__unit">
            <span class="countdown__num tabular" data-unit={unit.key}>
              {unit.value}
            </span>
            <span class="countdown__name">{unit.label}</span>
          </div>
        </>
      ))
    }
  </div>
  <p class="countdown__message" hidden data-countdown-message></p>
</div>

<style>
  .countdown__units {
    display: flex;
    align-items: flex-start;
    gap: clamp(0.35rem, 2vw, 0.9rem);
    margin-top: 0.6rem;
  }

  .countdown__unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 2.4ch;
  }

  .countdown__num,
  .countdown__sep {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 10vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .countdown__sep {
    color: var(--sea);
    opacity: 0.7;
  }

  .countdown__name {
    margin-top: 0.45rem;
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--stone);
  }

  .countdown__message {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 5vw, 2.25rem);
    line-height: 1.15;
    color: var(--sea);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-countdown]').forEach((root) => {
    const target = new Date(root.dataset.target ?? '').getTime();
    if (Number.isNaN(target)) return;
    const madridDay = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Madrid' });
    const weddingDay = madridDay.format(new Date(target));
    const pad = (n: number) => String(n).padStart(2, '0');

    const label = root.querySelector<HTMLElement>('[data-countdown-label]');
    const units = root.querySelector<HTMLElement>('[data-countdown-units]');
    const message = root.querySelector<HTMLElement>('[data-countdown-message]');
    const field = (key: string) => root.querySelector<HTMLElement>(`[data-unit="${key}"]`);
    const fields = { days: field('days'), hours: field('hours'), minutes: field('minutes'), seconds: field('seconds') };

    const tick = () => {
      const now = Date.now();
      const diff = target - now;
      if (diff <= 0) {
        if (units) units.hidden = true;
        if (label) label.hidden = true;
        if (message) {
          message.textContent = madridDay.format(new Date(now)) === weddingDay ? (root.dataset.today ?? '') : (root.dataset.past ?? '');
          message.hidden = false;
        }
        return false;
      }
      if (fields.days) fields.days.textContent = String(Math.floor(diff / 86_400_000));
      if (fields.hours) fields.hours.textContent = pad(Math.floor((diff / 3_600_000) % 24));
      if (fields.minutes) fields.minutes.textContent = pad(Math.floor((diff / 60_000) % 60));
      if (fields.seconds) fields.seconds.textContent = pad(Math.floor((diff / 1000) % 60));
      return true;
    };

    if (tick()) {
      const timer = window.setInterval(() => {
        if (!tick()) window.clearInterval(timer);
      }, 1000);
    }
  });
</script>
