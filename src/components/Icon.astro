---
import { icons, type IconName } from './icons';

interface Props {
  name: IconName;
  class?: string;
  /** Texto alternativo. Si no se indica, el icono es decorativo. */
  label?: string;
}

const { name, class: className, label, ...rest } = Astro.props;
---

<svg
  {...rest}
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  set:html={icons[name]}
/>
