---
import { Image } from 'astro:assets';
import { getDictionary, getLocale, interpolate, l } from '@/i18n';
import { placeImages, placeMapsUrl, type Place } from '@/data/santander';
import Icon from './Icon.astro';

interface Props {
  place: Place;
}

const { place } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = getDictionary(locale);
const images = placeImages(place);
---

<article class:list={['place', { 'place--two': images.length > 1, 'place--none': images.length === 0 }]}>
  <a class="place__media" href={placeMapsUrl(place)} target="_blank" rel="noopener noreferrer" aria-label={`${place.name} · ${t.common.viewOnMap}`}>
    {
      images.length > 0 ? (
        images.slice(0, 2).map((img, i) => (
          <Image class="place__img" src={img} alt={place.name} widths={[480, 800, 1200]} sizes="(min-width: 64em) 420px, (min-width: 40em) 50vw, 100vw" loading={i === 0 ? 'eager' : 'lazy'} />
        ))
      ) : (
        <span class="place__emoji" aria-hidden="true">{place.emoji}</span>
      )
    }
    <span class="place__badge" aria-hidden="true">{place.emoji}</span>
  </a>
  <div class="place__body">
    {place.favouriteOf && <p class="place__fav">{interpolate(t.santander.favouriteOf, { name: place.favouriteOf })}</p>}
    <h2 class="place__name">{place.name}</h2>
    <p class="place__comment">{l(place.comment, locale)}</p>
    <a class="arrow-link" href={placeMapsUrl(place)} target="_blank" rel="noopener noreferrer">
      {t.common.viewOnMap}
      <Icon name="external" />
    </a>
  </div>
</article>

<style>
  .place {
    display: flex;
    flex-direction: column;
    break-inside: avoid;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--white);
    border: 1px solid var(--line);
  }

  .place__media {
    position: relative;
    display: grid;
    gap: 3px;
    aspect-ratio: 4 / 5;
    background: var(--sun-2);
    overflow: hidden;
  }

  .place--two .place__media {
    grid-template-columns: 1fr 1fr;
    aspect-ratio: 8 / 5;
  }

  .place__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .place__media:hover .place__img {
    transform: scale(1.03);
  }

  .place--none .place__media {
    aspect-ratio: 16 / 9;
    place-items: center;
    background: linear-gradient(135deg, var(--sun-2), var(--coral-2));
  }

  .place__emoji {
    font-size: 4rem;
    line-height: 1;
  }

  .place__badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--white);
    box-shadow: var(--shadow);
    font-size: 1.25rem;
    line-height: 1;
  }

  .place--none .place__badge {
    display: none;
  }

  .place__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.1rem 1.25rem 1.25rem;
  }

  .place__fav {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--coral);
  }

  .place__name {
    font-size: clamp(1.5rem, 3.5vw, 1.875rem);
    line-height: 1.1;
  }

  .place__comment {
    color: var(--ink-2);
  }

  .place .arrow-link {
    margin-top: auto;
    padding-top: 0.5rem;
  }
</style>
