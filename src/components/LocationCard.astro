---
import { getDictionary, getLocale, l } from '@/i18n';
import type { Location } from '@/data/locations';
import Icon from './Icon.astro';

interface Props {
  location: Location;
  index: number;
}

const { location, index } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = getDictionary(locale);
---

<article class:list={['card location', { 'location--highlight': location.highlight }]}>
  <div class="location__head">
    <span class="location__num" aria-hidden="true">{index}</span>
    <div>
      <p class="eyebrow">{l(location.short, locale)}{location.time && <span class="location__time"> · {location.time}</span>}</p>
      <h3 class="location__name title-sm">{location.name}</h3>
    </div>
  </div>
  <address class="location__address small">
    {location.address.map((line) => <span>{line}</span>)}
  </address>
  {location.description && <p class="location__text small muted">{l(location.description, locale)}</p>}
  <a
    class:list={['btn btn--sm', location.highlight ? 'btn--primary' : 'btn--ghost']}
    href={location.mapsUrl}
    target="_blank"
    rel="noopener noreferrer"
  >
    {t.common.openInMaps}
    <Icon name="external" />
  </a>
</article>

<style>
  .location {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.5rem;
  }

  .location--highlight {
    border-color: var(--sea);
    box-shadow: inset 0 0 0 1px var(--sea);
  }

  .location__head {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .location__num {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-display);
    font-size: 1.125rem;
  }

  .location--highlight .location__num {
    background: var(--sea);
  }

  .location__time {
    color: var(--ink);
  }

  .location__name {
    margin-top: 0.35rem;
  }

  .location__address {
    display: flex;
    flex-direction: column;
    color: var(--ink-2);
  }

  .location .btn {
    align-self: flex-start;
    margin-top: auto;
  }
</style>
