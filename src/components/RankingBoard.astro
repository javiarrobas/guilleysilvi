---
import { getDictionary, getLocale } from '@/i18n';
import { href } from '@/i18n/routes';
import { siteConfig } from '@/site.config';
import Icon from './Icon.astro';

const locale = getLocale(Astro.currentLocale);
const t = getDictionary(locale);
const r = t.ranking;
const messages = { empty: r.empty, players: r.players, you: r.you, loading: r.loading, error: r.error };
---

<div class="board" data-ranking data-site={siteConfig.siteId} data-messages={JSON.stringify(messages)}>
  <div class="board__tools">
    <p class="small muted" data-ranking-count></p>
    <div class="board__actions">
      <button class="btn btn--ghost btn--sm" type="button" data-ranking-refresh>{r.refresh}</button>
      <a class="btn btn--primary btn--sm" href={href(locale, 'quiz')}>{r.play}<Icon name="arrowRight" /></a>
    </div>
  </div>
  <p class="board__status muted" data-ranking-status>{r.loading}</p>
  <ol class="board__list" data-ranking-list></ol>
</div>

<style>
  .board { max-width: 40rem; }
  .board__tools { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem; margin-bottom: 1rem; }
  .board__actions { display: flex; gap: 0.5rem; }
  .board__status { padding: 1.5rem 0; }
  .board__list { display: grid; gap: 0.5rem; }
  .board__list :global(.rank) { display: grid; grid-template-columns: 2rem 2.5rem minmax(0, 1fr) auto; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--white); }
  .board__list :global(.rank--top1) { border-color: var(--ink); }
  .board__list :global(.rank--me) { background: var(--sea-3); border-color: var(--sea); }
  .board__list :global(.rank__pos) { font-family: var(--font-display); font-size: 1.25rem; color: var(--stone); }
  .board__list :global(.rank--top1 .rank__pos), .board__list :global(.rank--top2 .rank__pos), .board__list :global(.rank--top3 .rank__pos) { color: var(--ink); }
  .board__list :global(.rank__emoji) { font-size: 1.75rem; line-height: 1; }
  .board__list :global(.rank__name) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 500; }
  .board__list :global(.rank__score) { font-family: var(--font-display); font-size: 1.375rem; }
</style>

<script>
  import { setupRanking } from '@/scripts/ranking';

  document.querySelectorAll<HTMLElement>('[data-ranking]').forEach(setupRanking);
</script>
