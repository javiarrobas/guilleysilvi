---
/**
 * Bloque de regalo: el texto de los novios y el IBAN con botón de copiar.
 * Se muestra solo si siteConfig.giftIban tiene valor.
 */
import { getDictionary, getLocale } from '@/i18n';
import { siteConfig } from '@/site.config';
import Icon from './Icon.astro';

interface Props {
  class?: string;
  id?: string;
}

const { class: className, id } = Astro.props;
const t = getDictionary(getLocale(Astro.currentLocale));
const iban = siteConfig.giftIban.replace(/\s+/g, '');
const pretty = iban.replace(/(.{4})/g, '$1 ').trim();
---

{
  iban && (
    <div class:list={['gift', className]} id={id} data-gift data-copied={t.gift.copied} data-copy={t.gift.copy} data-fail={t.gift.copyFail}>
      <span class="gift__emoji" aria-hidden="true">🎁</span>
      <div class="gift__body">
        <p class="eyebrow">{t.gift.eyebrow}</p>
        <h2 class="title-md gift__title">{t.gift.title}</h2>
        <p class="gift__text">{t.gift.text}</p>
        <div class="gift__row">
          <span class="gift__iban tabular" data-gift-iban data-value={iban}>{pretty}</span>
          <button class="gift__copy" type="button" data-gift-copy aria-label={t.gift.copy} title={t.gift.copy}>
            <Icon name="copy" class="gift__icon gift__icon--copy" />
            <Icon name="check" class="gift__icon gift__icon--check" />
          </button>
        </div>
        <p class="gift__status small" role="status" aria-live="polite" data-gift-status></p>
      </div>
    </div>
  )
}

<style>
  .gift {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: clamp(1.5rem, 5vw, 2.5rem);
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--coral-2), var(--sun-2));
  }

  .gift__emoji {
    font-size: 2rem;
    line-height: 1;
  }

  .gift__body {
    min-width: 0;
    flex: 1;
  }

  .gift__title {
    margin-top: 0.5rem;
  }

  .gift__text {
    margin-top: 0.75rem;
    max-width: 56ch;
    color: var(--ink-2);
  }

  /* El número, sin caja, con un icono discreto de copiar al lado. */
  .gift__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
    margin-top: 1rem;
  }

  .gift__iban {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 4.8vw, 1.375rem);
    line-height: 1.2;
    letter-spacing: 0.03em;
    word-spacing: 0.3em;
    color: var(--ink);
    white-space: nowrap;
    user-select: all;
    -webkit-user-select: all;
  }

  .gift__copy {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--sea);
    cursor: pointer;
    transition: background-color 0.2s var(--ease), transform 0.2s var(--ease);
  }

  .gift__copy:hover {
    background: rgba(31, 127, 140, 0.1);
  }

  .gift__copy:active {
    transform: scale(0.94);
  }

  .gift__icon {
    grid-area: 1 / 1;
    width: 1.25rem;
    height: 1.25rem;
    transition: opacity 0.2s var(--ease), transform 0.2s var(--ease);
  }

  .gift__icon--check {
    opacity: 0;
    transform: scale(0.6);
    stroke-width: 2.2;
  }

  .gift__copy.is-copied {
    color: var(--sea-dark);
  }

  .gift__copy.is-copied .gift__icon--copy {
    opacity: 0;
    transform: scale(0.6);
  }

  .gift__copy.is-copied .gift__icon--check {
    opacity: 1;
    transform: none;
  }

  .gift__status {
    min-height: 1.25rem;
    margin-top: 0.4rem;
    color: var(--sea-dark);
  }

  @media (max-width: 26em) {
    .gift {
      flex-direction: column;
      gap: 0.75rem;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-gift]').forEach((root) => {
    const button = root.querySelector<HTMLButtonElement>('[data-gift-copy]');
    const code = root.querySelector<HTMLElement>('[data-gift-iban]');
    const status = root.querySelector<HTMLElement>('[data-gift-status]');
    if (!button || !code || !status) return;
    let timer: number | undefined;
    button.addEventListener('click', async () => {
      const value = code.dataset.value ?? '';
      try {
        await navigator.clipboard.writeText(value);
        button.classList.add('is-copied');
        button.setAttribute('aria-label', root.dataset.copied ?? '');
        status.textContent = root.dataset.copied ?? '';
      } catch {
        // Sin portapapeles (navegador antiguo o contexto no seguro): seleccionamos el número.
        const range = document.createRange();
        range.selectNodeContents(code);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
        status.textContent = root.dataset.fail ?? '';
      }
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        button.classList.remove('is-copied');
        button.setAttribute('aria-label', root.dataset.copy ?? '');
        status.textContent = '';
      }, 2500);
    });
  });
</script>
