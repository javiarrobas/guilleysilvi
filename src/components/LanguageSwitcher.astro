---
/**
 * Selector de idioma. Solo se muestra cuando hay más de un idioma publicado
 * (siteConfig.enabledLocales). Enlaza a la misma página en el otro idioma.
 *
 *  - variant="codes": ES · CA · EN · TR en línea. Va en la cabecera, en todas las
 *    pantallas: los novios quieren que se vea de un vistazo que la web está en
 *    varios idiomas, sin desplegables.
 *  - variant="list" (por defecto): los nombres completos. Para el pie y el menú de móvil.
 */
import { getDictionary, getLocale, type Locale } from '@/i18n';
import { href, type PageKey } from '@/i18n/routes';
import { siteConfig } from '@/site.config';

interface Props {
  current?: PageKey;
  variant?: 'list' | 'codes';
  class?: string;
}

const { current = 'home', variant = 'list', class: className, ...rest } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = getDictionary(locale);
const enabled: Locale[] = siteConfig.enabledLocales;
---

{
  enabled.length > 1 && (
    <nav {...rest} class:list={['lang', `lang--${variant}`, className]} aria-label={t.common.language}>
      <ul class="lang__list">
        {enabled.map((code) => (
          <li>
            <a
              href={href(code, current)}
              hreflang={code}
              lang={code}
              aria-current={code === locale ? 'true' : undefined}
              aria-label={variant === 'codes' ? getDictionary(code).label : undefined}
              title={variant === 'codes' ? getDictionary(code).label : undefined}
              class="lang__link"
            >
              {variant === 'codes' ? code.toUpperCase() : getDictionary(code).label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  /* Con cuatro idiomas la fila de nombres no cabe en pantallas de 320 px: que se parta. */
  .lang__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }

  .lang__link {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--stone);
    padding-block: 0.25rem;
    border-bottom: 1px solid transparent;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease);
  }

  .lang__link:hover {
    color: var(--ink);
  }

  .lang__link[aria-current='true'] {
    color: var(--ink);
    border-color: var(--ink);
  }

  /* Códigos en línea (cabecera): compactos, sin partirse, área táctil de 2.25 rem. */
  .lang--codes .lang__list {
    flex-wrap: nowrap;
    gap: 0;
  }

  .lang--codes .lang__link {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0 0.35rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    border-bottom: 0;
  }

  .lang--codes .lang__link[aria-current='true'] {
    color: var(--sea);
    text-decoration: underline;
    text-underline-offset: 0.35em;
    text-decoration-thickness: 1.5px;
  }

  @media (min-width: 64em) {
    .lang--codes .lang__link {
      padding: 0 0.45rem;
      font-size: 0.75rem;
    }
  }
</style>
